# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtualenv
.venv/

# Generated data and model artifacts (data/download_ember2024.py,
# data/download_behavioral.py, and data/__init__.py are real source and
# stay tracked; only the generated/downloaded subdirectories under data/
# are ignored here). data/models/ covers api_vocab.json too, even though
# it's small enough to track by itself -- it's generated by the same
# training run as the checkpoint it's paired with and must stay in
# lockstep with it (a different train split or min_vocab_count produces a
# different vocab, silently breaking token-id alignment with a mismatched
# checkpoint), so it belongs with the other generated artifacts, not
# tracked separately from them.
data/processed/
data/models/
data/raw_behavioral_cache/
data/raw/

# Large/generated file types, as a safety net wherever they end up
*.parquet
*.lgbm
*.meta
*.pt
*.onnx

# Ad hoc code-transfer artifacts: a repo-snapshot archive, and the local
# file scp creates when the "user@host" destination is given with no
# trailing ":" (it then writes a local file literally named user@host).
*.zip
*@*.*.*.*
